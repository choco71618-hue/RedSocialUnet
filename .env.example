# Copiar a .env y ajustar si es necesario
DB_NAME=redsocial
DB_USER=redsocial
DB_PASSWORD=redsocial
DB_PORT=55432

PGADMIN_EMAIL=admin@redsocial.local
PGADMIN_PASSWORD=admin

# --- Almacenamiento de medios ---
# auto = usa S3 si hay credenciales, si no guarda en disco local
MEDIA_STORAGE=auto
MEDIA_LOCAL_DIR=uploads
# URL pública base para construir las URLs de los archivos locales (opcional)
MEDIA_PUBLIC_BASE_URL=
# Límites de tamaño en bytes (por defecto 8 MB imagen / 50 MB video)
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=52428800
# Tamaño máximo por request multipart (debe superar MEDIA_MAX_VIDEO_BYTES)
MEDIA_MAX_REQUEST_BYTES=57671680

# --- S3 (AWS o compatible: MinIO, etc.) ---
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL pública base del bucket (CDN / dominio). Si está vacía se usa la URL de S3.
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE=false
